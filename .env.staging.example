NODE_ENV=production
DATABASE_URL=postgresql://bayaraman:CHANGE_ME@postgres:5432/bayaraman
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
AUTH_SESSION_SECRET=CHANGE_ME_32_PLUS_RANDOM_BYTES
JOB_SCHEDULER_SECRET=CHANGE_ME_32_PLUS_RANDOM_BYTES

# Midtrans Sandbox only. Never place production credentials in this file.
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=CHANGE_ME_MIDTRANS_SANDBOX_SERVER_KEY
MIDTRANS_REQUEST_TIMEOUT_MS=10000
WHATSAPP_PROVIDER=manual
# Staging-only test mode; remove when a real WhatsApp provider is configured.
WHATSAPP_FAKE_OTP=

# Required compatibility placeholders; use non-production test values for staging.
BAYARAMAN_RECEIVING_BANK_NAME=STAGING_ONLY
BAYARAMAN_RECEIVING_ACCOUNT_NUMBER=STAGING_ONLY
BAYARAMAN_RECEIVING_ACCOUNT_HOLDER=BayarAman Staging
